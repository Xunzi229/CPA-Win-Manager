{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPA Mac Manager",
  "version": "1.5.16",
  "identifier": "com.routerforme.cpamacmanager",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CPA Mac 管理器",
        "width": 1080,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": {"resources/cpa-native-worker": "cpa-native-worker"},
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": []
    }
  }
}
